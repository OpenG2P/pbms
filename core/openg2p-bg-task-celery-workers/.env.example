BG_TASK_CELERY_WORKERS_G2P_BRIDGE_BASE_URL=http://g2pbridge-api

BG_TASK_CELERY_WORKERS_CELERY_BROKER_URL=redis://localhost:6379/0
BG_TASK_CELERY_WORKERS_CELERY_BACKEND_URL=redis://localhost:6379/0

BG_TASK_CELERY_WORKERS_BATCH_SIZE=2000
BG_TASK_CELERY_WORKERS_WORKER_MAX_ATTEMPTS=5

# Background task database
BG_TASK_CELERY_WORKERS_DB_USERNAME=postgres
BG_TASK_CELERY_WORKERS_DB_PASSWORD=postgres
BG_TASK_CELERY_WORKERS_DB_HOSTNAME=localhost
BG_TASK_CELERY_WORKERS_DB_PORT=5432
BG_TASK_CELERY_WORKERS_DB_DBNAME=bgtaskdb

# PBMS database
BG_TASK_CELERY_WORKERS_DB_USERNAME_PBMS=postgres
BG_TASK_CELERY_WORKERS_DB_PASSWORD_PBMS=postgres
BG_TASK_CELERY_WORKERS_DB_HOSTNAME_PBMS=localhost
BG_TASK_CELERY_WORKERS_DB_PORT_PBMS=5432
BG_TASK_CELERY_WORKERS_DB_DBNAME_PBMS=pbmsdb

# Background task database (async)
BG_TASK_CELERY_WORKERS_DB_DRIVER_ASYNC=postgresql+asyncpg
BG_TASK_CELERY_WORKERS_DB_USERNAME_ASYNC=postgres
BG_TASK_CELERY_WORKERS_DB_PASSWORD_ASYNC=postgres
BG_TASK_CELERY_WORKERS_DB_HOSTNAME_ASYNC=localhost
BG_TASK_CELERY_WORKERS_DB_PORT_ASYNC=5432
BG_TASK_CELERY_WORKERS_DB_DBNAME_ASYNC=bgtaskdb

# Registry adapter. Same variables on the staff API. db or dci.
REGISTRY_ADAPTERS_CONNECTOR=db
REGISTRY_ADAPTERS_DB_DRIVER=postgresql
REGISTRY_ADAPTERS_DB_USERNAME=postgres
REGISTRY_ADAPTERS_DB_PASSWORD=postgres
REGISTRY_ADAPTERS_DB_HOSTNAME=localhost
REGISTRY_ADAPTERS_DB_PORT=5432
REGISTRY_ADAPTERS_DB_DBNAME=socialregistrydb
REGISTRY_ADAPTERS_PARTNER_API_URL=http://localhost:8000
REGISTRY_ADAPTERS_PARTNER_API_TIMEOUT=30
REGISTRY_ADAPTERS_PARTNER_API_SSL_VERIFY=true
REGISTRY_ADAPTERS_FARMER_REG_TYPE=Farmer
REGISTRY_ADAPTERS_HOUSEHOLD_REG_TYPE=Household
REGISTRY_ADAPTERS_FARMER_REG_RECORD_TYPE=Farmer
REGISTRY_ADAPTERS_HOUSEHOLD_REG_RECORD_TYPE=Household

# One image runs worker or beat. The chart sets these per deployment.
CELERY_APP=openg2p_bg_task_celery_workers.main.celery_app
CELERY_OPTS=worker -Q bg_task_worker_queue --loglevel=info

BG_TASK_CELERY_WORKERS_KEYMANAGER_SIGN_APP_ID=OPENG2P_PBMS
BG_TASK_CELERY_WORKERS_KEYMANAGER_SIGN_REF_ID=
BG_TASK_CELERY_WORKERS_KEYMANAGER_API_TIMEOUT=10
BG_TASK_CELERY_WORKERS_KEYMANAGER_API_BASE_URL=
BG_TASK_CELERY_WORKERS_KEYMANAGER_AUTH_ENABLED=true
BG_TASK_CELERY_WORKERS_KEYMANAGER_AUTH_URL=
BG_TASK_CELERY_WORKERS_KEYMANAGER_AUTH_CLIENT_ID=openg2p-pbms
BG_TASK_CELERY_WORKERS_KEYMANAGER_AUTH_CLIENT_SECRET=
