BG_TASK_CELERY_BEAT_CELERY_BROKER_URL=redis://localhost:6379/0
BG_TASK_CELERY_BEAT_CELERY_BACKEND_URL=redis://localhost:6379/0

BG_TASK_CELERY_BEAT_PRODUCER_FREQUENCY=30
BG_TASK_CELERY_BEAT_BATCH_SIZE=2000
BG_TASK_CELERY_BEAT_NO_OF_TASKS_TO_PROCESS=5
BG_TASK_CELERY_BEAT_BG_TASK_WORKER_QUEUE=bg_task_worker_queue

# PBMS database
BG_TASK_CELERY_BEAT_DB_USERNAME_PBMS=postgres
BG_TASK_CELERY_BEAT_DB_PASSWORD_PBMS=postgres
BG_TASK_CELERY_BEAT_DB_HOSTNAME_PBMS=localhost
BG_TASK_CELERY_BEAT_DB_PORT_PBMS=5432
BG_TASK_CELERY_BEAT_DB_DBNAME_PBMS=pbmsdb

# One image runs worker or beat. The chart sets these on the beat deployment.
CELERY_APP=openg2p_bg_task_celery_beat_producers.main.celery_app
CELERY_OPTS=worker --beat -Q celery --loglevel=info --schedule=/tmp/celery-beat-schedule.db
